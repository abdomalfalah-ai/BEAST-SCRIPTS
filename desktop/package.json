{
  "name": "beast-scripts-desktop",
  "productName": "Beast Scripts",
  "version": "2.0.0",
  "description": "Beast Coaching AI Script Writer (offline desktop app)",
  "author": "Beast Coaching",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.beastcoaching.scripts",
    "productName": "Beast Scripts",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Beast-Scripts-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../public",
        "to": "public"
      }
    ]
  }
}
