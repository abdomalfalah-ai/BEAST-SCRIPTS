{
  "name": "beast-scripts-desktop",
  "productName": "Beast Scripts",
  "version": "1.0.0",
  "description": "Beast Coaching AI Script Writer (desktop)",
  "author": "Beast Coaching",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.beastcoaching.scripts",
    "productName": "Beast Scripts",
    "files": ["main.js", "offline.html", "icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Beast-Scripts-Setup-${version}.${ext}"
    }
  }
}
